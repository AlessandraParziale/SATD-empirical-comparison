{
  "repetitions": 10,
  "delay_seconds": 60,
  "randomize_order": true,
  "order_seed": 6666,
  "model_seed": 6666,
  "seed_mode": "fixed",
  "output_dir": "DL\\experiment_runs",
  "experiments": [
    {
      "id": "ggsatd-maldonado",
      "model": "ggsatd",
      "args": ["--task", "binary", "--dataset", "maldonado", "--glove", "DL\\glove.6B.300d.txt", "--device", "cuda"]
    },
    {
      "id": "bilstm-maldonado",
      "model": "bilstm",
      "args": ["--task", "binary", "--dataset", "maldonado", "--device", "cuda"]
    },
    {
      "id": "cnn-maldonado",
      "model": "cnn",
      "args": ["--task", "binary", "--dataset", "maldonado", "--device", "cuda"]
    },
    {
      "id": "ffnn-c1-maldonado",
      "model": "ffnn",
      "args": ["--task", "binary", "--dataset", "maldonado", "--hidden-layers", "1", "--device", "cuda"]
    },
    {
      "id": "mtbert-maldonado",
      "model": "mt-bert",
      "args": ["--datasets", "binary_maldonado", "multi_maldonado", "--device", "cuda"]
    }
  ]
}
